# 复制此文件并重命名为 .env

# ---- 大模型配置（默认使用 DeepSeek）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
# 如果使用其他模型，请修改上述三项。例如使用 OpenAI，则修改 base_url 为 https://api.openai.com/v1，模型为 gpt-4o

# ---- MCP 服务端配置 ----
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ---- 日志（observability/logger.py）----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Docker（core/motif.py）----
# 主机挂载路径风格：native = D:/DockerShare/...（默认）；wsl = /d/DockerShare/...
APTAMER_DOCKER_PATH_STYLE=native
